{
  "schemaVersion": 1,
  "id": "preset.points-race",
  "name": "得点レース（先取制）",
  "description": "好きな点数を加えていき、最初に目標点（100点）へ到達したプレイヤーが勝ち。",
  "origin": "preset",
  "iconSystemName": "flag.checkered",
  "themeColorHex": "#FF8A00",
  "players": { "min": 2, "max": 10, "default": 4, "teams": false },
  "structure": "freeform",
  "fields": [
    { "id": "points", "label": "得点", "type": "integer", "scope": "perPlayer", "default": 0, "min": 0 }
  ],
  "actions": [
    { "id": "add1", "label": "+1", "effects": [ { "target": "points", "op": "add", "value": 1 } ] },
    { "id": "add5", "label": "+5", "effects": [ { "target": "points", "op": "add", "value": 5 } ] },
    { "id": "addInput", "label": "入力した点を加える", "effects": [
      { "target": "points", "op": "applyExpression", "value": "field('points') + input()" }
    ] }
  ],
  "formulas": [
    { "id": "total", "label": "合計", "scope": "perPlayer", "expression": "field('points')", "display": true },
    { "id": "rank", "label": "順位", "scope": "perPlayer", "expression": "rankDesc('total')", "display": true }
  ],
  "layout": {
    "type": "vstack", "spacing": 12, "children": [
      { "type": "playerHeader" },
      { "type": "counter", "field": "points", "step": 1, "label": "得点" },
      { "type": "label", "bind": "total", "style": { "fontScale": 1.4, "emphasis": true } },
      { "type": "actionBar", "actions": ["add1", "add5", "addInput"] }
    ]
  },
  "winCondition": { "type": "firstToReach", "scoreFormula": "total", "target": 100, "tieBreaker": "none" }
}
