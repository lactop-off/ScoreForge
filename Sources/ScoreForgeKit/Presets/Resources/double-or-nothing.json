{
  "schemaVersion": 1,
  "id": "preset.double-or-nothing",
  "name": "ダブル・オア・ナッシング",
  "description": "各ラウンドの得点を入力。『勝負』をオンにすると得点は2倍、ただし0点だと何も入らない。合計が最も高い人が勝ち。",
  "origin": "preset",
  "iconSystemName": "dice",
  "themeColorHex": "#0F9D58",
  "players": { "min": 2, "max": 8, "default": 4, "teams": false },
  "structure": "rounds",
  "rounds": { "fixed": false, "maxRounds": 8 },
  "fields": [
    { "id": "points", "label": "得点", "type": "integer", "scope": "perPlayerPerRound", "default": 0, "min": 0, "max": 50 },
    { "id": "risked", "label": "勝負", "type": "bool", "scope": "perPlayerPerRound", "default": false }
  ],
  "actions": [
    { "id": "plus5", "label": "得点 +5", "effects": [ { "target": "points", "op": "add", "value": 5 } ] },
    { "id": "toggleRisk", "label": "勝負を切替", "effects": [ { "target": "risked", "op": "toggle" } ] }
  ],
  "formulas": [
    { "id": "roundScore", "label": "ラウンド得点", "scope": "perPlayerPerRound",
      "expression": "field('risked') ? field('points') * 2 : field('points')", "display": true },
    { "id": "total", "label": "合計", "scope": "perPlayer", "expression": "sumRounds('roundScore')", "display": true },
    { "id": "rank", "label": "順位", "scope": "perPlayer", "expression": "rankDesc('total')", "display": true }
  ],
  "layout": {
    "type": "vstack", "spacing": 12, "children": [
      { "type": "playerHeader" },
      { "type": "scoreTable", "rowField": "round", "columnGroup": "player", "cellFields": ["points", "risked", "roundScore"] },
      { "type": "hstack", "children": [
        { "type": "counter", "field": "points", "label": "得点", "step": 1 },
        { "type": "toggle", "field": "risked", "label": "勝負" }
      ] },
      { "type": "label", "bind": "total", "style": { "fontScale": 1.4, "emphasis": true } },
      { "type": "actionBar", "actions": ["plus5", "toggleRisk"] }
    ]
  },
  "winCondition": { "type": "highestTotal", "scoreFormula": "total", "tieBreaker": "none" }
}
